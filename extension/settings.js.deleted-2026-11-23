      const j = r.result || {};
      cb.checked = j.enabled !== false;
      if (desc) desc.textContent = j.desc || '';
      if (msg) {
        msg.style.color = j.enabled === false ? '#ffd79a' : '#9a9a9a';
        msg.textContent = (j.at ? ('设置于 ' + j.at + '　') : '') + (j.note || '') + (j.dupRows ? ('　(已留痕拦截记录 ' + j.dupRows + ' 条)') : '');
      }
    };
    chrome.runtime.sendMessage({ type: 'LISTING_BLOCKING' }, paint);
    cb.onchange = () => {
      if (msg) { msg.style.color = '#9a9a9a'; msg.textContent = '保存中…'; }
      chrome.runtime.sendMessage({ type: 'LISTING_BLOCKING', payload: { enabled: cb.checked } }, (r) => {
        const le = chrome.runtime.lastError;                 // ★ 同上: 不读就会报 Unchecked runtime.lastError
        if (le || !r || !r.ok) {
          if (msg) { msg.style.color = '#ffb4b4'; msg.textContent = '保存失败: ' + ((r && r.error) || (le && le.message) || '后台无响应'); }
          cb.checked = !cb.checked; return;
        }
        chrome.runtime.sendMessage({ type: 'LISTING_BLOCKING' }, paint);
        try { chrome.tabs.query({ url: 'https://www.ifast.top/*' }, (ts) => (ts || []).forEach((t) => { try { chrome.tabs.sendMessage(t.id, { type: 'SETTINGS_CHANGED' }, () => void chrome.runtime.lastError) } catch (e) {} })); } catch (e) {}
      });
    };
  }
  function renderShops() {
    const box = document.getElementById('zv-shops-list');
    if (!box) return;
    chrome.storage.local.get(['shops', 'currentShop'], (o) => {
      const shops = (o && o.shops) || {};
