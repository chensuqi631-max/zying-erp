/* 智赢采集器 —— 设置页
 *
 * 为什么单独做一个页面而不是塞进 popup:
 *   · popup 宽度上限 800px 且一关就没, 塞不下这些分组和说明;
 *   · 三个地方(采集器面板 / ifast 上架面板 / 工作台)都要能进设置 —— 统一跳这个页面最省事。
 *
 * 设置存在 chrome.storage.local 的两个键里(三处脚本共用同一份):
 *   settings —— 行为类: 采集/物流/上传默认值/连接
 *   pricing  —— 算价类: 利润率 + 各站 到手比例/汇率/本币调整 + 是否用实时汇率
 *               (各站那几张表在采集器面板的「⚙ 定价」里改, 这里只管利润率和汇率来源)
 */
'use strict';

/** 行为设置的默认值 —— 这里是唯一权威来源; 各处消费方用它兜底(键缺失时行为与这里一致)。 */
let ZT = { taxBySite: { UK: 0.68, DE: 0.68, AU: 0.85, ES: 0.68, IT: 0.68, FR: 0.68 }, taxLock: false };
const DEF = {
  autoVariantFetch: true,      // 详情页自动逐个直采变体
  rankFreshMin: 30,            // 排名快照新鲜度阈值(分钟)
  maxRows: 200,                // 面板最多显示行数
  logisticsPick: 'lowest',     // lowest | second —— 物流报价取最低/次低
  defaultWeightKg: 0,          // >0 时: 页面采不到重量就用它
  defaultScope: 'one',         // one | family —— 上传范围
  defaultFillMode: 'auto',     // auto | single | multi —— 上传方式
  defaultStock: 0,             // 默认库存
  defaultLeadDays: 15,         // 默认备货周期(天)
  defaultFollowPreset: 'allday', // 默认跟卖时间预设
  autoSubmit: true,            // 点上传后自动到 ifast 填表并保存
  apiDirect: true,             // ★ 优先直连 ifast 接口提交(不打开「添加跟卖」弹窗); 失败自动回退页面流程
  erpBase: 'http://127.0.0.1:3088',
  /* ★ 2026-11-14 列表页卡片底色（AMZ 蓝 / FBA 红 / FBM 绿） */
  zylColors: { amz: '#1677ff', fba: '#cf1322', fbm: '#237804' },
};

const $ = (id) => document.getElementById(id);
let S = Object.assign({}, DEF);       // settings
let P = { margin: 0.3, net: {}, fx: {}, adj: {}, useLiveFx: false };  // pricing
let rates = null, ratesAt = null;

const num = (v, d) => { const n = Number(v); return isNaN(n) ? d : n; };
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const msg = (t, cls) => { const m = $('msg'); m.textContent = t || ''; m.className = cls || ''; };

function load(cb) {
  chrome.storage.local.get(['settings', 'pricing', 'pricingRates', 'freightQuote', 'zyp_v3_settings'], (o) => {
    S = Object.assign({}, DEF, (o && o.settings) || {});
    const __zyp = (o && o.zyp_v3_settings) || null;
    if (__zyp) { ZT.taxBySite = Object.assign({}, ZT.taxBySite, __zyp.taxBySite || {}); ZT.taxLock = !!__zyp.taxLock; }
    const p = (o && o.pricing) || null;
    if (p) P = Object.assign({ margin: 0.3, net: {}, fx: {}, adj: {}, useLiveFx: false }, p);
    const rt = (o && o.pricingRates) || null;
    if (rt && rt.rates) { rates = rt.rates; ratesAt = rt.at || null; }
    FQ = (o && o.freightQuote) || null;
    if (cb) cb();
  });
}

function render() {
  $('margin').value = P.margin != null ? P.margin : 0.3;
  renderTax();
  $('useLiveFx').checked = !!P.useLiveFx;
  $('defaultWeightKg').value = num(S.defaultWeightKg, 0);
  $('rankFreshMin').value = num(S.rankFreshMin, 30);
  $('maxRows').value = num(S.maxRows, 200);
  $('autoVariantFetch').checked = !!S.autoVariantFetch;
  $('defaultStock').value = num(S.defaultStock, 0);
  $('defaultLeadDays').value = num(S.defaultLeadDays, 15);
  $('autoSubmit').checked = !!S.autoSubmit;
  $('apiDirect').checked = (S.apiDirect !== false);   // 默认开
  $('erpBase').value = S.erpBase || DEF.erpBase;
  $('defaultFollowPreset').value = S.defaultFollowPreset || DEF.defaultFollowPreset;
  seg('pickSeg', S.logisticsPick || DEF.logisticsPick);
  seg('scopeSeg', S.defaultScope || DEF.defaultScope);
  seg('modeSeg', S.defaultFillMode || DEF.defaultFillMode);
  renderFq();
  renderFx();
  renderData();
  renderColors();
}

function seg(id, on) {
  [...$(id).children].forEach((s) => s.classList.toggle('on', s.getAttribute('data-v') === on));
}
function segBind(id, key, after) {
  $(id).addEventListener('click', (e) => {
    const v = e.target && e.target.getAttribute && e.target.getAttribute('data-v');
    if (!v) return;
    seg(id, v); S[key] = v; if (after) after(v); dirty();
  });
}
let dirtyT = null;
function dirty() { msg('有未保存的改动', 'warn'); clearTimeout(dirtyT); dirtyT = setTimeout(() => { /* 提示常驻到保存 */ }, 100); }

/* ★ 物流报价表导入 (2026-09-28)
 * 背景: 面板上「按重量查物流成本」走 ERP(127.0.0.1:3088) 的 /api/logistics/rates,
 *       而那张表要手工录入、常常是空的 → 允许直接从报价表文件导入。
 * 存法: chrome.storage.local.freightQuote = { source, importedAt, channel, rates }
 *       rates = { GB: { '200': 27.13, '300': 31.58, ... }, ... }   (键 = 克数)
 * 用法: 后台 LOGISTICS_QUOTE 优先查这张表, 查不到的国家/重量才回落到 ERP。
 */
let FQ = null;
const FQ_SITE = {
  '德国': 'DE', '法国': 'FR', '英国': 'GB', '澳大利亚': 'AU', '澳洲': 'AU', '意大利': 'IT', '西班牙': 'ES',
  DE: 'DE', FR: 'FR', GB: 'GB', AU: 'AU', IT: 'IT', ES: 'ES', UK: 'GB',
};
function fqSiteCode(v) {
  const t = String(v == null ? '' : v).trim();
  if (!t) return null;
  const up = t.toUpperCase();
  if (FQ_SITE[up]) return FQ_SITE[up];
  for (const k in FQ_SITE) if (t.indexOf(k) >= 0) return FQ_SITE[k];
  return null;
}
/** 重量 → 克: 200g / 200 / 0.2(kg) / 1.5kg 都认 */
function fqGram(v) {
  let s = String(v == null ? '' : v).trim().toLowerCase();
  if (!s) return null;
  const isKg = /kg|千克|公斤/.test(s);
  s = s.replace(/[^0-9.]/g, '');
  const n = Number(s);
  if (!isFinite(n) || n <= 0) return null;
  const g = (isKg || n < 10) ? Math.round(n * 1000) : Math.round(n);
  return g > 0 ? g : null;
}
function fqPrice(v) {
  const s = String(v == null ? '' : v).replace(/[^0-9.]/g, '');
  const n = Number(s);
  return isFinite(n) && n > 0 ? Math.round(n * 100) / 100 : null;
}
function fqPut(rates, code, g, p) {
  if (!code || !g || p == null) return 0;
  (rates[code] = rates[code] || {})[String(g)] = p;
  return 1;
}
/** 「站点|重量|价格」三列一组 → rates (列数不固定, 逐列扫描, 认到就吃三列) */
function fqAddTriples(rows) {
  const rates = {}; let n = 0;
  for (const r of rows) {
    for (let i = 0; i + 2 < r.length; i++) {
      const code = fqSiteCode(r[i]); if (!code) continue;
      const g = fqGram(r[i + 1]); if (!g) continue;
      const p = fqPrice(r[i + 2]); if (p == null) continue;
      n += fqPut(rates, code, g, p);
      i += 2;
    }
  }
  return { rates, n };
}
function fqParseJson(text) {
  const j = JSON.parse(String(text).replace(/^\uFEFF/, ''));
  const rates = {};
  // ① 本插件/脚本导出的格式: { rates: { GB: { name, prices: { 200: 27.13 } } } }
  if (j && j.rates && typeof j.rates === 'object') {
    for (const k in j.rates) {
      const v = j.rates[k] || {};
      const code = fqSiteCode(k) || fqSiteCode(v.name);
      const prices = (v && typeof v === 'object' && (v.prices || v.rates)) || v;
      if (typeof prices !== 'object') continue;
      for (const g in prices) fqPut(rates, code, fqGram(g), fqPrice(prices[g]));
    }
  }
  // ② 直接 { GB: { '200': 27.13 } } / { 英国: { '200g': 27.13 } }
  if (!Object.keys(rates).length) {
    for (const k in j) {
      const code = fqSiteCode(k); const v = j[k];
      if (!code || !v || typeof v !== 'object') continue;
      for (const g in v) fqPut(rates, code, fqGram(g), fqPrice(v[g]));
    }
  }
  return rates;
}
function fqParseDelimited(text) {
  const sep = text.indexOf('\t') >= 0 ? '\t' : ',';
  const rows = text.split(/\r?\n/).filter((l) => l.trim()).map((l) => l.split(sep).map((x) => x.trim().replace(/^"|"$/g, '')));
  return fqAddTriples(rows).rates;
}
function fqColIdx(ref) { let n = 0; for (const ch of String(ref)) { const c = ch.charCodeAt(0); if (c < 65 || c > 90) break; n = n * 26 + (c - 64); } return n - 1; }
function fqXmlUnesc(s) { return String(s).replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&'); }
/** 极简 xlsx 读取: 只用 DecompressionStream('deflate-raw'), 不引第三方库
 *  ★ 2026-10-08: 多带一个 diag 出参 —— 解析不出报价时要说清"读到几行、第一行长什么样",
 *    否则用户只看到"解析不出报价", 完全不知道该改哪里(实测: 用户选到了「定价表.xlsx」这个文件夹)。 */
async function fqUnzip(buf) {
  const ent = {};
  const dv = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
  for (let i = 0; i + 30 < buf.length; i++) {
    if (!(buf[i] === 0x50 && buf[i + 1] === 0x4b && buf[i + 2] === 0x03 && buf[i + 3] === 0x04)) continue;
    const method = dv.getUint16(i + 8, true);
    const compSize = dv.getUint32(i + 18, true);
    const nameLen = dv.getUint16(i + 26, true);
    const extraLen = dv.getUint16(i + 28, true);
    const name = new TextDecoder('utf-8').decode(buf.subarray(i + 30, i + 30 + nameLen));
    const start = i + 30 + nameLen + extraLen;
    if (!compSize) continue;
    const data = buf.subarray(start, start + compSize);
    try {
      if (method === 0) ent[name] = data;
      else if (method === 8) {
        const ds = new DecompressionStream('deflate-raw');
        const out = await new Response(new Blob([data]).stream().pipeThrough(ds)).arrayBuffer();
        ent[name] = new Uint8Array(out);
      }
    } catch (e) { /* 某一条解不开就跳过 */ }
    i = start + compSize - 1;
  }
  return ent;
}
async function fqParseXlsx(file, diag) {
  if (typeof DecompressionStream !== 'function') throw new Error('本浏览器不支持解压 xlsx, 请另存为 csv 再导入');
  const ent = await fqUnzip(new Uint8Array(await file.arrayBuffer()));
  const dec = new TextDecoder('utf-8');
  if (diag) diag.entries = Object.keys(ent).length;
  const shared = [];
  if (ent['xl/sharedStrings.xml']) {
    const sx = dec.decode(ent['xl/sharedStrings.xml']);
    for (const m of sx.matchAll(/<si[^>]*>([\s\S]*?)<\/si>/g)) {
      shared.push([...m[1].matchAll(/<t[^>]*>([\s\S]*?)<\/t>/g)].map((x) => fqXmlUnesc(x[1])).join(''));
    }
  }
  const sheets = Object.keys(ent).filter((k) => /^xl\/worksheets\/.*\.xml$/.test(k));
  if (diag) { diag.sheets = sheets.length; diag.shared = shared.length }
  const key = Object.keys(ent).find((k) => /^xl\/worksheets\/sheet1\.xml$/.test(k)) || sheets[0];
  if (!key) { if (diag) diag.why = '不是有效的 xlsx（解压后没有工作表）'; throw new Error('xlsx 里没找到工作表') }
  const sx = dec.decode(ent[key]);
  const rows = [];
  for (const rm of sx.matchAll(/<row[^>]*>([\s\S]*?)<\/row>/g)) {
    const cells = [];
    for (const cm of rm[1].matchAll(/<c([^>]*?)(?:\/>|>([\s\S]*?)<\/c>)/g)) {
      const attrs = cm[1] || ''; const inner = cm[2] || '';
      const ref = (attrs.match(/\br="([A-Z]+)\d+"/) || [])[1] || '';
      const t = (attrs.match(/\bt="([^"]+)"/) || [])[1] || '';
      let v = '';
      if (t === 'inlineStr') v = [...inner.matchAll(/<t[^>]*>([\s\S]*?)<\/t>/g)].map((x) => x[1]).join('');
      else {
        const vm = inner.match(/<v[^>]*>([\s\S]*?)<\/v>/);
        v = vm ? vm[1] : '';
        if (t === 's') v = shared[Number(v)] != null ? shared[Number(v)] : '';
      }
      const ci = fqColIdx(ref);
      if (ci >= 0) cells[ci] = fqXmlUnesc(v);
    }
    for (let i = 0; i < cells.length; i++) if (cells[i] == null) cells[i] = '';
    if (cells.some((x) => String(x).trim() !== '')) rows.push(cells);
  }
  if (diag) { diag.rows = rows.length; diag.firstRow = (rows[0] || []).slice(0, 6).map((x) => String(x).slice(0, 14)) }
  return fqAddTriples(rows).rates;
}
/** 一句人话: 这个文件为什么解析不出报价(给用户看, 别只说"解析不出") */
function fqWhy(diag, cells) {
  if (!diag) return '解析不出报价';
  if (cells) return '';
  if (diag.kind === 'json') return 'JSON 结构不认识（既不是 {rates:{GB:{prices:{…}}}} 也不是 {GB:{"200":27.13}}）';
  if (diag.entries === 0) return '不是有效的 xlsx（一个内部文件都没解出来）';
  if (diag.sheets === 0) return '不是有效的 xlsx（解压后没有工作表）';
  if (diag.rows === 0) return '表是空的（没有读到任何一行）';
  if (diag.rows != null) {
    const fr = (diag.firstRow || []).filter(Boolean).join(' | ');
    return '读到 ' + diag.rows + ' 行，但每行都凑不出「站点|重量|价格」三列' + (fr ? ('（第一行是：' + fr + '）') : '');
  }
  return '按 ' + (diag.sep === '\t' ? 'Tab' : '逗号') + ' 切列后凑不出三列组' + ((diag.firstRow || []).length ? ('（第一行是：' + diag.firstRow.filter(Boolean).join(' | ') + '）') : '');
}
const FQ_TIP = '正确格式：一行里横向排若干组「站点|重量|价格」，例如 <code>英国|200g|27.13|德国|200g|56.24</code>（重量 200g / 200 / 0.2 都认；站点认 德国/法国/英国/澳大利亚/意大利/西班牙 或 DE/FR/GB/AU/IT/ES）。';
async function fqParseFile(file, diag) {
  const nm = String(file.name || '').toLowerCase();
  if (diag) diag.name = file.name;
  if (/\.xlsx?$|\.xlsm$/.test(nm)) { if (diag) diag.kind = 'xlsx'; return fqParseXlsx(file, diag) }
  const text = String(await file.text()).replace(/^\uFEFF/, '');   // 有些编辑器写出的 json/csv 带 BOM
  if (/\.json$/.test(nm)) { if (diag) diag.kind = 'json'; return fqParseJson(text) }
  if (diag) { diag.kind = 'text'; diag.sep = text.indexOf('\t') >= 0 ? '\t' : ','; diag.rows = text.split(/\r?\n/).filter((l) => l.trim()).length; diag.firstRow = (text.split(/\r?\n/)[0] || '').split(text.indexOf('\t') >= 0 ? '\t' : ',').slice(0, 6).map((x) => x.trim().slice(0, 14)) }
  return fqParseDelimited(text);
}
function fqCount(rates) {
  const sites = Object.keys(rates || {}).filter((k) => Object.keys(rates[k]).length);
  return { sites: sites.length, cells: sites.reduce((a, k) => a + Object.keys(rates[k]).length, 0) };
}
function renderFq() {
  const el = $('fqMeta'); if (!el) return;
  if (!FQ || !FQ.rates) { el.innerHTML = '未导入 —— 查询走 ERP（<code>127.0.0.1:3088</code>）的物流报价表'; return; }
  const c = fqCount(FQ.rates);
  el.innerHTML = '<span class="ok">✓ 已导入</span> <b>' + esc(FQ.source || '') + '</b>：' + c.sites + ' 个国家 / ' + c.cells +
    ' 个重量档 · 渠道 <b>' + esc(FQ.channel || '云途普货') + '</b> · ' + esc(FQ.importedAt || '');
}
/** 用一份文件的内容建表并保存 */
async function fqTakeFile(file, label) {
  const diag = {};
  const rates = await fqParseFile(file, diag);
  const c = fqCount(rates);
  if (!c.cells) throw new Error('没解析出报价：' + (fqWhy(diag, 0) || '需要「站点|重量|价格」三列一组的表'));
  FQ = { source: label || file.name, importedAt: new Date().toISOString().slice(0, 16).replace('T', ' '), channel: '云途普货', rates };
  await new Promise((res) => chrome.storage.local.set({ freightQuote: FQ }, res));
  renderFq();
  try { chrome.runtime.sendMessage({ type: 'FREIGHT_QUOTE_CHANGED' }, () => void chrome.runtime.lastError); } catch (e) {}
  msg('✓ 已导入 ' + (label || file.name) + '：' + c.sites + ' 个国家 / ' + c.cells + ' 个重量档', 'ok');
}
async function fqImportFolder() {
  if (typeof window.showDirectoryPicker !== 'function') { msg('本浏览器不支持选文件夹，请用「选单个文件」', 'warn'); return; }
  let dir = null;
  try { dir = await window.showDirectoryPicker({ id: 'zyingFreightQuote', mode: 'read' }); } catch (e) { return; }  // 取消
  const cands = [];
  try {
    for await (const [name, h] of dir.entries()) {
      if (h.kind !== 'file') continue;
      if (/\.(xlsx|xlsm|json|csv|tsv)$/i.test(name)) cands.push([name, h]);
    }
  } catch (e) { msg('✗ 读文件夹失败: ' + e.message, 'bad'); return; }
  if (!cands.length) { msg('✗ 这个文件夹里没有 .xlsx / .xlsm / .json / .csv / .tsv 文件', 'bad'); return; }
  const score = (n) => { const s = n.toLowerCase(); let v = 0; if (/物流|运费|报价|freight/.test(s)) v += 10; if (/\.xlsx?$/.test(s)) v += 6; else if (/\.json$/.test(s)) v += 4; else v += 2; return v; };
  cands.sort((a, b) => score(b[0]) - score(a[0]));
  // 桌面上常有好几份同名表(旧的档数一样但值是旧的) —— 每个都解析一遍: 先比档数, 平手取“最近修改”的那份
  let best = null;
  const tries = [];                       // ★ 逐个留证: 文件名 + 组数 + 为什么不行(用户要看得懂)
  for (const [name, h] of cands) {
    const diag = {};
    try {
      const file = await h.getFile();
      const rates = await fqParseFile(file, diag);
      const c = fqCount(rates);
      const mt = Number(file.lastModified) || 0;
      tries.push({ name, cells: c.cells, why: fqWhy(diag, c.cells) });
      if (c.cells > 0 && (!best || c.cells > best.cells || (c.cells === best.cells && mt > best.mt))) best = { name, rates, sites: c.sites, cells: c.cells, mt };
    } catch (e) { tries.push({ name, cells: 0, why: diag.why || ('读不出来: ' + ((e && e.message) || e)) }) }
  }
  if (!best) {
    /* ★ 2026-10-08 用户报障「这个文件夹里的 1 个表格都解析不出报价」—— 原来只说这一句, 用户完全不知道
     *   该改哪里(实测他选到了放着「定价表.xlsx」的文件夹: 那是"定价参数表", 根本不带站点/重量/价格)。
     *   现在把每个文件为什么不行写清楚, 并给出正确格式示例。
     *   ★ 注意 msg() 用的是 textContent(不是 innerHTML) → 只能纯文本, 用「；」分隔, 不能用 <br>。 */
    msg('✗ 这个文件夹里 ' + cands.length + ' 个表格都解析不出报价 —— ' +
      tries.map((t) => t.name + '：' + (t.why || '没有报价数据')).join('；') +
      '。' + FQ_TIP.replace(/<[^>]+>/g, '') + '（也可点「选单个文件」直接挑那份报价表）', 'bad');
    return;
  }
  FQ = { source: best.name + '  (文件夹 ' + dir.name + ')', importedAt: new Date().toISOString().slice(0, 16).replace('T', ' '), channel: '云途普货', rates: best.rates };
  await new Promise((res) => chrome.storage.local.set({ freightQuote: FQ }, res));
  renderFq();
  try { chrome.runtime.sendMessage({ type: 'FREIGHT_QUOTE_CHANGED' }, () => void chrome.runtime.lastError); } catch (e) {}
  msg('✓ 已导入 ' + esc(best.name) + '：' + best.sites + ' 个国家 / ' + best.cells + ' 个重量档' + (cands.length > 1 ? ('（文件夹里还有 ' + (cands.length - 1) + ' 个表格，已自动挑最全的）') : ''), 'ok');
}


/** 汇率区: 显示当前生效的是什么 + 实时值 */
function renderFx() {
  const SITE = { uk: ['英国', 'GBP', '£'], de: ['德国', 'EUR', '€'], au: ['澳大利亚', 'AUD', 'A$'] };
  const rows = [];
  for (const k of Object.keys(SITE)) {
    const [cn, code] = SITE[k];
    const table = (P.fx && P.fx[k] != null && P.fx[k] !== '') ? Number(P.fx[k]) : null;
    const live = (rates && rates[code] != null) ? Number(rates[code]) : null;
    let use = null, src = '';
    if (P.useLiveFx && live != null) { use = live; src = 'live' }
    else if (table != null) { use = table; src = 'tbl' }
    else if (live != null) { use = live; src = 'live' }
    rows.push('<tr><td>' + cn + ' <span class="pill">' + code + '</span></td>' +
      '<td class="num">' + (table != null ? table : '—') + '</td>' +
      '<td class="num">' + (live != null ? live : '—') + '</td>' +
      '<td class="num"><b>' + (use != null ? use : '—') + '</b> ' +
      (src === 'live' ? '<span class="pill live">实时</span>' : '<span class="pill tbl">表</span>') +
      '</td></tr>');
  }
  $('fxTable').innerHTML = '<table><thead><tr><th>站点</th><th>表里值</th><th>实时值</th><th>当前生效</th></tr></thead><tbody>' + rows.join('') + '</tbody></table>';
  $('fxMeta').innerHTML = rates
    ? ('来源 <b>' + esc((rates._source || 'ERP')) + '</b> · 取到时间 ' + esc(ratesAt || '—') + ' · 共 ' + Object.keys(rates).length + ' 个币种')
    : '还没取过实时汇率（点左边按钮）';
}

async function fetchRates() {
  const base = String($('erpBase').value || DEF.erpBase).replace(/\/+$/, '');
  msg('正在拉取汇率…', '');
  try {
    const r = await fetch(base + '/api/rates', { signal: AbortSignal.timeout(20000) });
    const j = await r.json();
    if (!j || !j.rates) throw new Error('返回里没有 rates');
    rates = j.rates; rates._source = j.source || 'ERP'; ratesAt = new Date().toISOString().slice(0, 16).replace('T', ' ');
    chrome.storage.local.set({ pricingRates: { at: ratesAt, base: j.base, date: j.date, source: j.source, rates: j.rates } });
    renderFx();
    msg('✓ 汇率已更新（' + (j.date || '') + '）', 'ok');
  } catch (e) {
    msg('✗ 拉取失败: ' + (e && e.message ? e.message : e) + '（确认 ERP 在 ' + base + ' 上跑着）', 'bad');
  }
}

function renderData() {
