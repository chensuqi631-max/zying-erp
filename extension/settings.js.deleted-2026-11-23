      box.innerHTML = keys.map((k) => {
        const v = shops[k] || {};
        const groups = (v.sellingGroups || []).map((x) => x.name).filter(Boolean).slice(0, 4).join('、');
        return '<div style="padding:4px 0;border-bottom:1px dashed rgba(255,255,255,.08)">' +
          (k === cur ? '🟢 ' : '⚪ ') + '<b>' + k + '</b>' +
          ' <span style="color:#9a9a9a">' + ((v.countries || []).join('/') || '未知站点') +
          ' · 跟卖组 ' + ((v.sellingGroups || []).length) + (groups ? ('(' + groups + ')') : '') +
          ' · 上架 ' + (v.listedCount == null ? '?' : v.listedCount) +
          ' · 最近见到 ' + (v.lastSeen || '?') + '</span>' +
          ' <button data-zv-del="' + k + '" class="btn2" style="padding:1px 7px;font-size:11px">删除</button></div>';
      }).join('');
    });
  }
  try { initShops(); } catch (e) {}
  $('clrDemo').onclick = () => {
    chrome.storage.local.get(['bench', 'rowdata'], (o) => {
      const b = (o && o.bench) || [];
      const demo = b.filter((x) => x && x.__demo === true);
      if (!demo.length) { msg('✓ 没有示例数据了（工作台共 ' + b.length + ' 行）', 'ok'); return }
      if (!confirm('清掉工作台里的 ' + demo.length + ' 条示例数据？\n\n（你自己扫描的真实行不受影响）')) return;
      const demoKeys = {};
      demo.forEach((x) => { try { demoKeys[String(x.site || '').toLowerCase() + '|' + String(x.asin || '').toUpperCase()] = 1 } catch (e) {} });
      const rd = Object.assign({}, (o && o.rowdata) || {});
      let rdKilled = 0;
      Object.keys(rd).forEach((k) => { if (demoKeys[k]) { delete rd[k]; rdKilled++ } });
      chrome.storage.local.set({ bench: b.filter((x) => !(x && x.__demo === true)), rowdata: rd }, () => {
        renderData();
        msg('✓ 已清掉 ' + demo.length + ' 条示例数据' + (rdKilled ? ('（连带 ' + rdKilled + ' 条示例填写记录）') : '') + ' —— 刷新采集器页面即可看到', 'ok');
      });
    });
  };
}

