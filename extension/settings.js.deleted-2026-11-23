  function initBlocking() {
    const cb = document.getElementById('zv-blocking');
    if (!cb) return;
    const desc = document.getElementById('zv-blocking-desc');
    const msg = document.getElementById('zv-blocking-msg');
    const paint = (r) => {
      /* ★ 2026-10-07: 回调式 sendMessage 必须读 lastError → 否则"后台没回"会留 Unchecked runtime.lastError */
      const le = chrome.runtime.lastError;
      if (le) { if (msg) { msg.style.color = '#ffb4b4'; msg.textContent = '读取拦截开关失败: 后台无响应(' + (le.message || '端口已关') + ') —— 刷新本页再试'; } return }
