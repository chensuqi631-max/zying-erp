      '<button id="zv-shops-clear" class="btn2">清空全部店铺记录</button></div>' +
      /* ★ 2026-10-07 新增: 「重复上架拦截」总开关(存在 ERP, 跟数据走 —— 换浏览器/换机器状态一致) */
      '<div style="margin-top:10px;padding:8px 10px;border:1px solid rgba(255,255,255,.12);border-radius:8px">' +
        '<label style="display:flex;align-items:center;gap:8px;cursor:pointer">' +
          '<input type="checkbox" id="zv-blocking" style="width:15px;height:15px">' +
