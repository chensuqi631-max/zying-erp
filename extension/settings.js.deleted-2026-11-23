  const cur = (ZT.taxBySite || {})[site];
  val.value = (cur == null ? '' : cur);
  lock.checked = !!ZT.taxLock;
  sel.onchange = function () { renderTax(); };
  val.onchange = function () { saveTaxFromUI(); };
  lock.onchange = function () { saveTaxFromUI(); };
}
function saveTaxFromUI() {
  const sel = $('taxSite'), val = $('taxVal'), lock = $('taxLock');
  if (!sel || !val) return;
  const site = sel.value || 'DE';
  const raw = val.value.trim();
  if (!ZT.taxBySite || typeof ZT.taxBySite !== 'object') ZT.taxBySite = {};
  if (raw === '') delete ZT.taxBySite[site];
  else ZT.taxBySite[site] = Number(raw);
  ZT.taxLock = !!(lock && lock.checked);
  chrome.storage.local.get(['zyp_v3_settings'], (o) => {
    const z = (o && o.zyp_v3_settings) || {};
    z.taxBySite = Object.assign({}, z.taxBySite || {}, ZT.taxBySite);
    z.taxLock = !!ZT.taxLock;
    chrome.storage.local.set({ zyp_v3_settings: z }, () => {
      try { chrome.runtime.sendMessage({ type: 'SETTINGS_CHANGED', zyp: z }, () => void chrome.runtime.lastError); } catch (e) {}
      msg('✓ 税率已保存: ' + site + ' = ' + (raw === '' ? '(清空)' : raw), 'ok');
    });
  });
}
