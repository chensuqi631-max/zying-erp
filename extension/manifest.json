{
  "manifest_version": 3,
  "name": "搞薯条ERP",
  "version": "2.11.27",
  "description": "自研 Amazon 采集插件: 采集入库 → ERP 上架记录 → ifast 自动上架 · 多店铺隔离 · 重复上架拦截(可开关) · 已存在时用 item_edit.json 更新现有记录 · 修 ifast 请求头(X-Requested-With) · 商品面板(详情页/列表页BG)",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:3088/*",
    "http://localhost:3088/*",
    "https://www.amazon.com/*",
    "https://www.amazon.de/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.in/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.nl/*",
    "https://www.amazon.se/*",
    "https://www.amazon.pl/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.com.br/*",
    "https://www.amazon.sg/*",
    "https://www.amazon.ae/*",
    "https://www.amazon.sa/*",
    "https://www.ifast.top/*",
    "https://ifast.top/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background-3.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ifast.top/*",
        "https://ifast.top/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*"
      ],
      "js": [
        "zy-panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*"
      ],
      "js": [
        "zy-list.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "智赢采集器 v2 — 本页商品信息"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "settings.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "short_name": "搞薯条ERP"
}