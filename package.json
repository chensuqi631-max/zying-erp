{
  "name": "zying-erp",
  "version": "1.3.0",
  "description": "搞薯条 · 智赢ERP：亚马逊选品/跟卖/上架一体化（多链接全流程采集 · 智赢数据源 · 多站点 BG·排名·配送·价格 · FBA/FBM 利润测算 · ifast 上架 · 多站点 BG 面板）— DeepSeek Harness 插件 + 浏览器扩展",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "amazon",
    "erp",
    "选品",
    "跟卖",
    "bg",
    "ifast",
    "profit-calculator",
    "product-research",
    "extension"
  ],
  "author": "搞薯条 · 智赢ERP",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "engines": {
